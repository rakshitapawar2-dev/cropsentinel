# ---------------------------------------------------------------------------
# CropSentinel environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# With no values set, the app runs in clearly-labelled local demo mode
# (data is stored in this browser only).
# ---------------------------------------------------------------------------

# Supabase project (Settings -> API). The anon key is public by design;
# all protection comes from Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Storage bucket used for crop images.
VITE_SUPABASE_STORAGE_BUCKET=crop-images

# Optional: crop disease model service (Python/FastAPI).
# Leave empty until the model is actually deployed — the UI then shows
# "Crop image analysis is not connected yet".
VITE_CROP_CLINIC_URL=

# Optional: Arduino / soil-moisture gateway base URL. Read-only ingest.
VITE_SENSOR_GATEWAY_URL=

# Dev-server hostname allowlist, comma separated. Needed only when the dev
# server is reached through a proxy/preview hostname (not for localhost).
VITE_ALLOWED_HOSTS=

# NOTE: never put provider API keys (OpenAI, Anthropic, ...) in VITE_* variables.
# They are compiled into the browser bundle. AI provider keys belong in Supabase
# Edge Function secrets: `supabase secrets set OPENAI_API_KEY=...`
